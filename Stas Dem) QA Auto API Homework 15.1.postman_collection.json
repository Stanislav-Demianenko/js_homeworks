    {
      "name": "01 - Create User",
      "item": [
        {
          "name": "01 - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const requestBody = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "const responseBody = pm.response.json();",
                  "",
                  "pm.environment.set(\"oldPassword\", requestBody.password);",
                  "pm.environment.set(\"userEmail\", requestBody.email);",
                  "pm.environment.set(\"userId\", responseBody.data.userId);",
                  "",
                  "pm.test(\"Status code is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Email is valid\", () => {",
                  "    pm.expect(requestBody.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
                  "});",
                  "",
                  "pm.test(\"JSON schema is valid\", () => {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\",",
                  "        required: [\"status\", \"data\"],",
                  "        properties: {",
                  "            status: { type: \"string\" },",
                  "            data: {",
                  "                type: \"object\",",
                  "                required: [\"userId\"],",
                  "                properties: {",
                  "                    userId: { type: \"integer\" }",
                  "                }",
                  "            }",
                  "        }",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueEmail = `stas.qa.${Date.now()}@gmail.com`;",
                  "",
                  "pm.environment.set(\"userEmail\", uniqueEmail);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stas\",\n  \"lastName\": \"Demianenko\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{oldPassword}}\",\n  \"repeatPassword\": \"{{oldPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negative Signup Tests",
      "item": [
        {
          "name": "NEG - Signup Validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseBody = pm.response.json();",
                  "const expectedMessage = pm.variables.get(\"expectedMessage\");",
                  "",
                  "pm.test(\"Status code is 400\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Correct error message\", () => {",
                  "    pm.expect(responseBody.message).to.eql(expectedMessage);",
                  "});",
                  "",
                  "const index = Number(pm.environment.get(\"signupEmailIndex\"));",
                  "",
                  "if (index !== 0) {",
                  "    pm.execution.setNextRequest(\"NEG - Signup Validation\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const cases = [",
                  "    {",
                  "        email: \"\",",
                  "        message: \"\\\"email\\\" is not allowed to be empty\"",
                  "    },",
                  "    {",
                  "        email: \"stas.gmail.com\",",
                  "        message: \"Email is incorrect\"",
                  "    },",
                  "    {",
                  "        email: \"stas@\",",
                  "        message: \"Email is incorrect\"",
                  "    },",
                  "    {",
                  "        email: \"@gmail.com\",",
                  "        message: \"Email is incorrect\"",
                  "    },",
                  "    {",
                  "        email: \"stas@gmailcom\",",
                  "        message: \"Email is incorrect\"",
                  "    },",
                  "    {",
                  "        email: \"stas qa@gmail.com\",",
                  "        message: \"Email is incorrect\"",
                  "    },",
                  "    {",
                  "        email: \"stas@@gmail.com\",",
                  "        message: \"Email is incorrect\"",
                  "    }",
                  "];",
                  "",
                  "let index = Number(pm.environment.get(\"signupEmailIndex\") || 0);",
                  "",
                  "pm.environment.set(\"negativeEmail\", cases[index].email);",
                  "pm.environment.set(\"expectedMessage\", cases[index].message);",
                  "",
                  "index++;",
                  "",
                  "if (index >= cases.length) {",
                  "    index = 0;",
                  "}",
                  "",
                  "pm.environment.set(\"signupEmailIndex\", index);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Stas\",\n    \"lastName\": \"Demianenko\",\n    \"email\": \"{{negativeEmail}}\",\n    \"password\": \"{{oldPassword}}\",\n    \"repeatPassword\": \"{{oldPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        }
      ]
    },
