              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\nconst mileage = Number(pm.environment.get(\"expenseMileage\"));\nconst carId = Number(pm.environment.get(\"carId\"));\n\npm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Expense mileage is correct\", () => {\n    pm.expect(body.data.mileage).to.eql(mileage);\n});\n\npm.test(\"CarId is correct\", () => {\n    pm.expect(body.data.carId).to.eql(carId);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"reportedAt\": \"{{$isoTimestamp}}\",\n  \"mileage\": {{expenseMileage}},\n  \"liters\": 40,\n  \"totalCost\": 60,\n  \"forceMileage\": false\n}",
