              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Invalid dateBirth type is not applied\", () => {\n    pm.expect(body.data.dateBirth).to.be.a(\"string\");\n});\n\nconst index = Number(pm.environment.get(\"profileValidationIndex\"));\n\nif (index !== 0) {\n    pm.execution.setNextRequest(\"NEG - Profile Validation\");\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
