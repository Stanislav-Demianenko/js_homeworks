    {
      "name": "01 - Create User",
      "item": [
        {
          "name": "01 - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestBody = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));\nconst body = pm.response.json();\n\npm.environment.set(\"oldPassword\", requestBody.password);\npm.environment.set(\"userEmail\", requestBody.email);\npm.environment.set(\"userId\", body.data.userId);\n\npm.test(\"Status code is 201\", () => {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Email is valid\", () => {\n    pm.expect(requestBody.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);\n});\n\npm.test(\"JSON schema is valid\", () => {\n    pm.response.to.have.jsonSchema({\n        type: \"object\",\n        required: [\"status\", \"data\"],\n        properties: {\n            status: { type: \"string\" },\n            data: {\n                type: \"object\",\n                required: [\"userId\"],\n                properties: {\n                    userId: { type: \"integer\" }\n                }\n            }\n        }\n    });\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = `stas.qa.${Date.now()}@gmail.com`;\nconst password = \"Qa12345678!\";\n\npm.environment.set(\"userEmail\", uniqueEmail);\npm.environment.set(\"oldPassword\", password);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stas\",\n  \"lastName\": \"Demianenko\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{oldPassword}}\",\n  \"repeatPassword\": \"{{oldPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negative Signup Tests",
      "item": [
        {
          "name": "NEG - Signup Validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\nconst expectedMessage = pm.variables.get(\"expectedMessage\");\nconst nextIndex = Number(pm.environment.get(\"signupEmailIndex\"));\n\npm.test(\"Status code is 400\", () => {\n    pm.response.to.have.status(400);\n});\n\npm.test(\"Correct error message\", () => {\n    pm.expect(body.message).to.eql(expectedMessage);\n});\n\nif (nextIndex !== 0) {\n    pm.execution.setNextRequest(\"NEG - Signup Validation\");\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cases = [\n    {\n        email: \"\",\n        message: \"\\\"email\\\" is not allowed to be empty\"\n    },\n    {\n        email: \"stas.gmail.com\",\n        message: \"Email is incorrect\"\n    },\n    {\n        email: \"stas@\",\n        message: \"Email is incorrect\"\n    },\n    {\n        email: \"@gmail.com\",\n        message: \"Email is incorrect\"\n    },\n    {\n        email: \"stas@gmailcom\",\n        message: \"Email is incorrect\"\n    },\n    {\n        email: \"stas qa@gmail.com\",\n        message: \"Email is incorrect\"\n    },\n    {\n        email: \"stas@@gmail.com\",\n        message: \"Email is incorrect\"\n    }\n];\n\nlet index = Number(pm.environment.get(\"signupEmailIndex\") || 0);\n\npm.environment.set(\"negativeEmail\", cases[index].email);\npm.environment.set(\"expectedMessage\", cases[index].message);\n\nindex++;\n\nif (index >= cases.length) {\n    index = 0;\n}\n\npm.environment.set(\"signupEmailIndex\", index);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Stas\",\n    \"lastName\": \"Demianenko\",\n    \"email\": \"{{negativeEmail}}\",\n    \"password\": \"{{oldPassword}}\",\n    \"repeatPassword\": \"{{oldPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        }
      ]
    },
